@@ -21,6 +24,65 @@ type SyncHandler struct {
 	store *store.Store
 }
 
+type networkEventReq struct {
+	ClientUUID   string `json:"client_uuid"`
+	DeviceID     string `json:"device_id"`
+	BusinessID   *string `json:"business_id"`
+	EventType    string `json:"event_type"`
+	PreviousSSID string `json:"previous_ssid"`
+	SSID         string `json:"ssid"`
+	BSSID        string `json:"bssid"`
+	Interface    string `json:"interface_name"`
+	LocalIP      string `json:"local_ip"`
+	SignalPct    *int   `json:"signal_pct"`
+	OccurredAt   int64  `json:"occurred_at"`
+}
+
+// NetworkEvent records a Windows desktop connection, switch, or disconnect.
+// Passwords and Wi-Fi authentication material are never accepted.
+func (h *SyncHandler) NetworkEvent(c *gin.Context) {
+	userID, _ := auth.UserID(c)
+	var req networkEventReq
+	if err := c.ShouldBindJSON(&req); err != nil {
+		badRequest(c, "invalid body")
+		return
+	}
+	if validUUID(req.ClientUUID) != nil || validUUID(req.DeviceID) != nil {
+		badRequest(c, "client_uuid and device_id must be UUIDs")
+		return
+	}
+	if req.EventType != "connected" && req.EventType != "switched" && req.EventType != "disconnected" {
+		badRequest(c, "invalid event_type")
+		return
+	}
+	if req.SignalPct != nil && (*req.SignalPct < 0 || *req.SignalPct > 100) {
+		badRequest(c, "signal_pct must be between 0 and 100")
+		return
+	}
+	businessID, err := h.store.ResolveBusinessForUser(c.Request.Context(), userID, req.BusinessID)
+	if err != nil {
+		c.JSON(http.StatusForbidden, gin.H{"error": "not a member of that business"})
+		return
+	}
+	city := firstHeader(c, "CF-IPCity", "X-Vercel-IP-City", "X-AppEngine-City")
+	if decoded, err := url.QueryUnescape(city); err == nil {
+		city = decoded
+	}
+	event := store.NetworkEventRow{
+		ClientUUID: req.ClientUUID, DeviceID: req.DeviceID, EventType: req.EventType,
+		PreviousSSID: strings.TrimSpace(req.PreviousSSID), SSID: strings.TrimSpace(req.SSID),
+		BSSID: strings.TrimSpace(req.BSSID), Interface: strings.TrimSpace(req.Interface),
+		LocalIP: strings.TrimSpace(req.LocalIP), PublicIP: c.ClientIP(), SignalPct: req.SignalPct,
+		Country: firstHeader(c, "CF-IPCountry", "X-Vercel-IP-Country", "X-AppEngine-Country"),
+		City: city, OccurredAt: time.Unix(req.OccurredAt, 0).UTC(),
+	}
+	if err := h.store.RecordNetworkEvent(c.Request.Context(), userID, businessID, event); err != nil {
+		serverError(c, err)
+		return
+	}
+	c.Status(http.StatusNoContent)
+}
+
 // NewSyncHandler wires the sync handler.
 func NewSyncHandler(s *store.Store) *SyncHandler {
 	return &SyncHandler{store: s}
