+import { useEffect, useState } from "react";
+import { listNetworkEvents } from "../api/endpoints";
+import { ApiError, type NetworkEvent } from "../api/types";
+import { Empty, Notice, Spinner } from "../components/ui";
+import { useBusinesses } from "../useBusinesses";
+
+function eventLabel(event: NetworkEvent) {
+  if (event.event_type === "switched") return `${event.previous_ssid || "Unknown"} → ${event.ssid || "Unknown"}`;
+  if (event.event_type === "disconnected") return `Disconnected from ${event.previous_ssid || "Wi-Fi"}`;
+  return `Connected to ${event.ssid || "Wi-Fi"}`;
+}
+
+export function NetworkHistory() {
+  const { selected, selectedId, loading: businessLoading } = useBusinesses();
+  const [events, setEvents] = useState<NetworkEvent[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    if (!selectedId) return;
+    setLoading(true);
+    setError("");
+    void listNetworkEvents(selectedId)
+      .then(result => setEvents(result.network_events))
+      .catch(err => setError(err instanceof ApiError ? err.message : "Could not load Wi-Fi history."))
+      .finally(() => setLoading(false));
+  }, [selectedId]);
+
+  return <div className="ad-wrap" style={{ paddingBottom: 32 }}>
+    <div className="ad-pagehead"><div className="ad-pagehead__main">
+      <h1 className="ad-h1">Wi-Fi history</h1>
+      <p className="ad-sub">Windows network changes for {selected?.name ?? "this workspace"}.</p>
+    </div></div>
+    <Notice kind="info">BiBoTracking records network names and connection metadata—not Wi-Fi passwords. Public-IP locations are approximate.</Notice>
+    {error && <Notice kind="danger">{error}</Notice>}
+    {(businessLoading || loading) && <Spinner label="Loading Wi-Fi history…" />}
+    {!businessLoading && !loading && !selected && <Empty>Create or select a workspace first.</Empty>}
+    {!loading && selected && events.length === 0 && <Empty>No Wi-Fi changes recorded yet. Install the updated Windows desktop app and sign in.</Empty>}
+    {!loading && events.length > 0 && <div className="card" style={{ marginTop: 18, overflowX: "auto" }}>
+      <table className="ad-table"><thead><tr>
+        <th>User</th><th>Network change</th><th>Date and time</th><th>Public IP</th><th>Location</th><th>Details</th>
+      </tr></thead><tbody>{events.map(event => <tr key={event.id}>
+        <td><strong>{event.display_name}</strong><div className="ad-login">{event.email || event.username}</div></td>
+        <td><strong>{eventLabel(event)}</strong></td>
+        <td>{new Date(event.occurred_at).toLocaleString()}</td>
+        <td><code>{event.public_ip || "—"}</code></td>
+        <td>{[event.city, event.country].filter(Boolean).join(", ") || "Not available"}</td>
+        <td title={`Device ${event.device_id}`}>
+          <div>{event.bssid ? `Access point: ${event.bssid}` : "No access point"}</div>
+          <div className="ad-login">Local IP: {event.local_ip || "—"} · Signal: {event.signal_pct == null ? "—" : `${event.signal_pct}%`}</div>
+        </td>
+      </tr>)}</tbody></table>
+    </div>}
+  </div>;
+}
