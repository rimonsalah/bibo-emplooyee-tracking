diff --git a/apps/desktop/src-tauri/src/network.rs b/apps/desktop/src-tauri/src/network.rs
new file mode 100644
index 0000000..fb71b94
--- /dev/null
+++ b/apps/desktop/src-tauri/src/network.rs
@@ -0,0 +1,136 @@
+//! Windows Wi-Fi transition observer. Collects connection metadata only—never
+//! passwords, saved profiles, or authentication material.
+
+use std::sync::Arc;
+
+use crate::settings::SettingsState;
+use crate::sync::client::{BackendClient, NetworkEventIn};
+use crate::sync::AuthState;
+
+#[cfg(target_os = "windows")]
+#[derive(Debug, Clone, Default, PartialEq)]
+struct Snapshot {
+    ssid: String,
+    bssid: String,
+    interface_name: String,
+    local_ip: String,
+    signal_pct: Option<i32>,
+}
+
+#[cfg(target_os = "windows")]
+pub fn start(auth: Arc<AuthState>, settings: Arc<SettingsState>) {
+    std::thread::spawn(move || {
+        let runtime = match tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+        {
+            Ok(runtime) => runtime,
+            Err(error) => {
+                crate::log_warn!("network", "runtime build failed: {error}");
+                return;
+            }
+        };
+        runtime.block_on(observe(auth, settings));
+    });
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn start(_auth: Arc<AuthState>, _settings: Arc<SettingsState>) {}
+
+#[cfg(target_os = "windows")]
+async fn observe(auth: Arc<AuthState>, settings: Arc<SettingsState>) {
+    use std::collections::VecDeque;
+    use std::time::Duration;
+
+    let mut previous: Option<Snapshot> = None;
+    let mut pending: VecDeque<NetworkEventIn> = VecDeque::new();
+
+    loop {
+        let current = read_snapshot();
+        if current != previous {
+            let event_type = match (&previous, &current) {
+                (None, Some(_)) => "connected",
+                (Some(_), None) => "disconnected",
+                (Some(_), Some(_)) => "switched",
+                (None, None) => "disconnected",
+            };
+            let old_ssid = previous.as_ref().map(|s| s.ssid.clone()).unwrap_or_default();
+            let now = current.clone().unwrap_or_default();
+            let configured = settings.current.lock().unwrap().clone();
+            if !configured.device_id.is_empty() {
+                pending.push_back(NetworkEventIn {
+                    client_uuid: uuid::Uuid::new_v4().to_string(),
+                    device_id: configured.device_id,
+                    business_id: auth.session().and_then(|session| session.business_id),
+                    event_type: event_type.to_string(),
+                    previous_ssid: old_ssid,
+                    ssid: now.ssid,
+                    bssid: now.bssid,
+                    interface_name: now.interface_name,
+                    local_ip: now.local_ip,
+                    signal_pct: now.signal_pct,
+                    occurred_at: crate::now_unix(),
+                });
+            }
+            previous = current;
+        }
+
+        if auth.is_logged_in() {
+            if let Some(event) = pending.front() {
+                let client = BackendClient::new(crate::settings::backend_base_url(), auth.clone());
+                if client.sync_network_event(event).await.is_ok() {
+                    pending.pop_front();
+                }
+            }
+        }
+        tokio::time::sleep(Duration::from_secs(10)).await;
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn read_snapshot() -> Option<Snapshot> {
+    use std::os::windows::process::CommandExt;
+    use std::process::Command;
+
+    const CREATE_NO_WINDOW: u32 = 0x08000000;
+    let output = Command::new("netsh")
+        .args(["wlan", "show", "interfaces"])
+        .creation_flags(CREATE_NO_WINDOW)
+        .output()
+        .ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&output.stdout);
+    let mut snapshot = Snapshot::default();
+    for line in text.lines() {
+        let Some((raw_key, raw_value)) = line.split_once(':') else { continue };
+        let key = raw_key.trim().to_ascii_lowercase();
+        let value = raw_value.trim();
+        match key.as_str() {
+            "name" => snapshot.interface_name = value.to_string(),
+            "ssid" => snapshot.ssid = value.to_string(),
+            "bssid" => snapshot.bssid = value.to_string(),
+            "signal" => snapshot.signal_pct = value.trim_end_matches('%').parse().ok(),
+            _ => {}
+        }
+    }
+    // SSID/BSSID are WLAN protocol labels and remain stable even on localized
+    // Windows installations; human-readable fields such as "State" do not.
+    if snapshot.ssid.is_empty() {
+        return None;
+    }
+    snapshot.local_ip = local_ip();
+    Some(snapshot)
+}
+
+#[cfg(target_os = "windows")]
+fn local_ip() -> String {
+    std::net::UdpSocket::bind("0.0.0.0:0")
+        .and_then(|socket| {
+            socket.connect("1.1.1.1:80")?;
+            socket.local_addr()
+        })
+        .map(|address| address.ip().to_string())
+        .unwrap_or_default()
+}
