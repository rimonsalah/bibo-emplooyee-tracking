 };
 
 // One gallery card: real thumbnail when it loads, gradient placeholder before.
+async function downloadScreenshot(meta: ScreenshotMeta) {
+  const url = await fetchImageObjectUrl(meta.client_uuid);
+  try {
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = `screenshot-${new Date(meta.ts * 1000).toISOString().replace(/[:.]/g, "-")}.webp`;
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+  } finally {
+    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }
+}
+
