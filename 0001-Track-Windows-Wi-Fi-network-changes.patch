@@ -286,6 +302,31 @@ impl BackendClient {
 
     // ---------- sync (task 53) ----------
 
+    /// Upload one queued network transition. The backend derives the public IP
+    /// from the request; the desktop sends connection metadata only.
+    pub async fn sync_network_event(&self, event: &NetworkEventIn) -> Result<(), String> {
+        let mut token = self.access_token()?;
+        for attempt in 0..2 {
+            let resp = self
+                .http
+                .post(self.url("/v1/sync/network-events"))
+                .bearer_auth(&token)
+                .json(event)
+                .send()
+                .await
+                .map_err(net_err)?;
+            if resp.status() == reqwest::StatusCode::UNAUTHORIZED && attempt == 0 {
+                token = self.refresh().await?;
+                continue;
+            }
+            if !resp.status().is_success() {
+                return Err(status_err(resp).await);
+            }
+            return Ok(());
+        }
+        Err("sync_network_event: unreachable retry exhaustion".into())
+    }
+
     /// `POST /v1/sync/batch` with auto-refresh on 401. Returns the accepted uuids
     /// per kind. `device_id` and the (optional) `business_id` come from settings/
     /// session.
